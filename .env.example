# گِرِه — local environment (SPEC §9: secrets arrive via env on the box).
# This file is gitignored; copy to `.env` and edit locally.

# Public storefront URL for absolute links, sitemap, metadata, and callbacks
NEXT_PUBLIC_BASE_URL=https://gereh.shop

# SQLite file location (ADR-0003). Relative paths resolve against the app root.
DATABASE_PATH=gereh.db

# First staff user, created by `pnpm db:seed` (SPEC §3).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_DISPLAY_NAME=مدیر کارگاه

# SMS — off until the Kavenegar plan is bought (SPEC §4).
# Production boot guard will refuse to start if SMS_SEND=false in production!
SMS_SEND=false
KAVENEGAR_API_KEY=
FARAZSMS_API_KEY=

# ZarinPal — sandbox works with any UUID as merchant_id (SPEC §5).
# Swap ZARINPAL_BASE_URL to https://payment.zarinpal.com for production.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com

# Nightly backup off-box destination (rsync target, SPEC §9)
# Example: user@backup-vps.ir:/backups/gereh/
REMOTE_BACKUP_DEST=
